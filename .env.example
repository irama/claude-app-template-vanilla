# Copy this file to .env.local and fill in real values
# .env.local is gitignored — never commit real secrets

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (if used)
# NEXT_PUBLIC_SUPABASE_URL=your-project-url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sentry error monitoring (docs/production-playbook.md — wire per project)
# Create project at sentry.io → Settings → Projects → <project> → Client Keys (DSN).
# Leave empty locally (SDK no-ops); set in Vercel for Preview + Production.
NEXT_PUBLIC_SENTRY_DSN=

# Add project-specific variables below

# ── Health v3 rich diagnostics (docs/health-contract.md) ────────────────────
# HEALTH_READ_TOKENS — comma-separated bearer(s) for the /api/health rich tier. ONE
# fleet-wide value: the hub presents it to every app AND this app's own /api/health
# accepts it. Comma list so old+new overlap during rotation (zero-downtime).
# Generated 2026-07-19 (openssl rand -hex 32). Paste this SAME value into:
#   1. Vercel → status project → Settings → Environment Variables →
#      HEALTH_READ_TOKENS (Production + Preview)
#   2. EVERY fleet app adopting the v3 rich tier: its .env.local + its Vercel env
#      (same var name HEALTH_READ_TOKENS)
HEALTH_READ_TOKENS=your-64-hex-fleet-token

# ── Jev classifier cascade (docs/classifier-cascade.md, lib/jev.ts, lib/jev.py) ──
# OPENROUTER_API_KEY — an OpenRouter INFERENCE sub-key with a hard spend limit, minted at
# openrouter.ai → Settings → Keys. Not the management key: each endpoint refuses the other.
OPENROUTER_API_KEY=
# JEV_SHADOW_ENABLED — the kill switch. 1, true, yes or on turns the classifier on; anything
# else, including unset, short-circuits every call before it reaches the network. Deliberately
# separate from OPENROUTER_API_KEY, because the existing model this app falls back to usually
# reaches OpenRouter through that same key.
JEV_SHADOW_ENABLED=0
# Spend attribution on the OpenRouter dashboard. Sent as http-referer and x-title. Either can
# be passed per call instead.
JEV_APP_URL=
JEV_APP_NAME=
